{
  "name": "DentPixel - Dental Clinic Website & Practice Management System",
  "short_name": "DentPixel",
  "description": "Modern patient website and complete staff management system tailored to your dental clinic.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#F5FAFE",
  "theme_color": "#0EA5C9",
  "orientation": "portrait-primary",
  "categories": ["medical", "business", "productivity"],
  "icons": [
    {
      "src": "/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "lang": "en-IN",
  "dir": "ltr",
  "scope": "/",
  "prefer_related_applications": false
}
